{
  "name": "canrush.ru",
  "private": true,
  "version": "0.1.0",
  "description": "canrush.ru - monorepo: парсер цен на энергетики + будущий сайт",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "parse": "npm run parse -w apps/parser --",
    "schedule": "npm run schedule -w apps/parser --",
    "doctor": "npm run doctor -w apps/parser --",
    "session:unlock": "npm run session:unlock -w apps/parser --"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
