{
  "name": "canrush.ru",
  "private": true,
  "version": "0.1.0",
  "description": "canrush.ru - monorepo: парсер цен на энергетики + будущий сайт",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps/parser packages/shared && cd apps/site && eslint .",
    "test": "npm run test --workspaces --if-present",
    "parse": "npm run parse -w apps/parser --",
    "schedule": "npm run schedule -w apps/parser --",
    "doctor": "npm run doctor -w apps/parser --",
    "session:unlock": "npm run session:unlock -w apps/parser --",
    "ingredients": "npm run ingredients -w apps/parser --",
    "ingredients:publish": "npm run ingredients:publish -w apps/parser"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
