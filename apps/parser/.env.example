# Расписание регулярного запуска (node-cron), по умолчанию раз в сутки в 6:00 МСК
CRON_SCHEDULE="0 6 * * *"

# Если на машине установлен настоящий Google Chrome — можно использовать его вместо
# бандлового Chromium от Playwright (дополнительно снижает детект автоматизации).
# PARSER_BROWSER_CHANNEL=chrome

# Уведомления в Telegram при блокировке/ошибке источника (опционально)
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# URL партнёрского товарного фида Ozon (Admitad и т.п.), см. src/feed/ozonFeed.ts
# OZON_FEED_URL=

# Необязательный поиск составов; реальный ключ хранить в apps/parser/.env.local
TAVILY_API_KEY=
