DATABASE_URL=postgresql://localhost:5432/canrush_site_dev
TEST_DATABASE_URL=postgresql://localhost:5432/canrush_site_test
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
SMTP_USER=noreply@canrush.ru
SMTP_PASSWORD=
MAIL_FROM_NAME=CanRush
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-...); loads only after the cookie notice is accepted
GOOGLE_ANALYTICS_ID=
YANDEX_SITE_VERIFICATION=
# Telegram Mini App (optional). Bot token from @BotFather and the direct Mini App link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://t.me/<bot>/<app>
# Bot webhook (random 32+ chars [A-Za-z0-9_-]); register with npm -w apps/site run telegram:setup
TELEGRAM_WEBHOOK_SECRET=
# HTTPS reverse proxy to api.telegram.org abroad, if this host cannot reach Telegram (see AGENTS.md).
TELEGRAM_API_URL=
# Webhook address on that relay, forwarded to /api/telegram/webhook (used by telegram:setup).
TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WORKER=off disables the outbox sender and scheduled bot jobs in this process.
# Password sign-in for the Google Play / RuStore reviewer only (optional). Hash: npm -w apps/site run review:password
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_PASSWORD_HASH=
# Android push (optional). FCM: path to the Firebase service account JSON (not committed); RuStore Push: project id and service token
FCM_SERVICE_ACCOUNT_FILE=
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_TOKEN=
# PUSH_WORKER=off disables the push sender in this process
# HTTP Geocoder key for store addresses (server only)
YANDEX_GEOCODER_API_KEY=
