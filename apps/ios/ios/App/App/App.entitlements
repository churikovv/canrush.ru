<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push through APNs; an App Store archive is re-signed with the production environment. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: canrush.ru links (and the sign-in letter) open in the app; the site serves
	     /.well-known/apple-app-site-association with this app's Team ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:canrush.ru</string>
		<string>applinks:www.canrush.ru</string>
	</array>
</dict>
</plist>
