<?xml version="1.0" encoding="utf-8"?>
<!-- Быстрые действия по долгому нажатию на иконку. Ссылку открывает MainActivity.openSiteLink. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="drink"
        android:enabled="true"
        android:icon="@drawable/shortcut_drink"
        android:shortcutShortLabel="@string/shortcut_drink_short"
        android:shortcutLongLabel="@string/shortcut_drink_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://canrush.ru/calendar"
            android:targetPackage="ru.canrush.app"
            android:targetClass="ru.canrush.app.MainActivity" />
    </shortcut>

    <shortcut
