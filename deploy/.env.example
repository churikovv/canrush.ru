# =============================================================================
# canrush.ru — Deployment Environment Variables
# Copy this file to .env (in the repo root, next to docker-compose.yml)
# and fill in the values. DO NOT commit .env to git.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=canrush
POSTGRES_USER=canrush
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Site: Auth ----
# Must be HTTPS in production
BETTER_AUTH_URL=https://canrush.ru
# Generate a secret: openssl rand -base64 48 (must be ≥32 bytes)
BETTER_AUTH_SECRET=

# ---- Site: SMTP (SpaceWeb, implicit TLS on port 465) ----
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
# SMTP_USER must match the From address
SMTP_USER=noreply@canrush.ru
SMTP_PASSWORD=
MAIL_FROM_NAME=CanRush

# ---- Site: Optional ----
GOOGLE_SITE_VERIFICATION=

# ---- Parser ----
# Cron schedule (Europe/Moscow timezone). Default: daily at 6:00 AM
CRON_SCHEDULE=0 6 * * *
# Optional: Telegram notifications for source blocks/errors
# TG_BOT_TOKEN=
# TG_CHAT_ID=
