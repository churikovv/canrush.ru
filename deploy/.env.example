# =============================================================================
# canrush.ru — Deployment Environment Variables
# Copy this file to .env (in the repo root, next to docker-compose.yml)
# and fill in the values. DO NOT commit .env to git.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=canrush
POSTGRES_USER=canrush
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Site: Auth ----
# Must be HTTPS in production
BETTER_AUTH_URL=https://canrush.ru
# Generate a secret: openssl rand -base64 48 (must be ≥32 bytes)
BETTER_AUTH_SECRET=

# ---- Site: SMTP (SpaceWeb, implicit TLS on port 465) ----
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
# SMTP_USER must match the From address
SMTP_USER=noreply@canrush.ru
SMTP_PASSWORD=
MAIL_FROM_NAME=CanRush

# ---- Site: Optional ----
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-...); loads only after the cookie notice is accepted
GOOGLE_ANALYTICS_ID=
# HTTP Geocoder key for store addresses (server only)
YANDEX_GEOCODER_API_KEY=

# ---- Site: Android app ----
# Store reviewer password sign-in (hash: npm -w apps/site run review:password)
# REVIEW_LOGIN_EMAIL=review@canrush.ru
# REVIEW_LOGIN_PASSWORD_HASH=scrypt:...
# Push: Firebase service account JSON in ./secrets (mounted read-only into the site container)
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/canrush/firebase-service-account.json
# RUSTORE_PUSH_PROJECT_ID=
# RUSTORE_PUSH_TOKEN=
# Google Play app signing SHA-256 for /.well-known/assetlinks.json (comma-separated)
# ANDROID_APP_SHA256=

# ---- Parser ----
# Cron schedule (Europe/Moscow timezone). Default: daily at 6:00 AM
CRON_SCHEDULE=0 6 * * *
# Optional: Telegram notifications for source blocks/errors
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# Telegram Mini App and bot for the site (optional).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MINI_APP_URL=https://t.me/<bot>/<app>
# Random 32+ chars [A-Za-z0-9_-]; then run: docker compose exec site node apps/site/scripts/telegram-setup.mjs
# TELEGRAM_WEBHOOK_SECRET=
# HTTPS reverse proxy to api.telegram.org on a server abroad, when Telegram is unreachable from this host.
# TELEGRAM_API_URL=https://tg.example.com
# Public webhook address on the relay, forwarded to https://<site>/api/telegram/webhook; when Telegram cannot reach this host.
# TELEGRAM_WEBHOOK_URL=https://tg.example.com/<secret>/webhook
